# Production environment template for self-hosted installs.
# Copy values into a real .env file on the target host.
# Do not commit real .env files, secrets, passwords, tokens, private keys,
# certificate material, backup artifact paths, or connection strings.

DJANGO_ENV=production
DJANGO_DEBUG=False

# Generate strong, unique values on the target host.
DJANGO_SECRET_KEY=CHANGE_ME_STRONG_UNIQUE_DJANGO_SECRET
JWT_SIGNING_KEY=CHANGE_ME_STRONG_UNIQUE_JWT_SIGNING_KEY

# Replace with the real production host/domain.
DJANGO_ALLOWED_HOSTS=it.example.invalid

# Replace with production database values.
POSTGRES_DB=it_inventory
POSTGRES_USER=it_inventory_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Replace with the real HTTPS frontend origin.
CORS_ALLOWED_ORIGINS=https://it.example.invalid
CSRF_TRUSTED_ORIGINS=https://it.example.invalid
AUTH_COOKIE_REQUIRE_ORIGIN=true
AUTH_COOKIE_ALLOWED_ORIGINS=https://it.example.invalid

# Compose Redis service default.
REDIS_URL=redis://redis:6379/0

# Tune for the organization if needed.
LOGIN_THROTTLE_RATE=5/5m
BACKEND_PORT=8000

