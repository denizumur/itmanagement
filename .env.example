DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-bytes-long
JWT_SIGNING_KEY=change-me-to-a-random-jwt-signing-key-at-least-32-bytes-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=it_inventory
POSTGRES_USER=it_user
POSTGRES_PASSWORD=it_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
LOGIN_THROTTLE_RATE=5/5m
REDIS_URL=redis://redis:6379/0
AUTH_COOKIE_REQUIRE_ORIGIN=false
AUTH_COOKIE_ALLOWED_ORIGINS=http://localhost:5173

# Invitation email delivery
INVITATION_EMAIL_ENABLED=false

# Django email backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=CHANGE_ME_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_SMTP_USER
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=CHANGE_ME_FROM@example.invalid
SERVER_EMAIL=CHANGE_ME_SERVER@example.invalid

# Frontend base URL used for activation links
APP_FRONTEND_URL=http://localhost:5173
